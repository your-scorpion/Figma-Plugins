{
  "compilerOptions": {
    "target": "es2017",                        
    "module": "commonjs",                      
    "rootDir": "src",
    "outDir": "dist",
    "jsx": "react-jsx",                        
    "strict": true,                            
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,                   
    "removeComments": true,
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["@figma/plugin-typings"]
  },
  "include": ["src"]
}
